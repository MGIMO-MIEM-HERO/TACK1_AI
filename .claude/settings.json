{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python3 scripts/validate_project.py:*)",
      "Bash(python3 scripts/checkpoint.py:*)",
      "Bash(python3 scripts/ledger.py:*)",
      "Bash(python3 scripts/snapshot.py:*)",
      "Bash(python3 scripts/analyze_experiment.py:*)",
      "Bash(python3 scripts/generate_demo.py:*)",
      "Bash(python3 -m unittest:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./**/sources/private/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/session_start.py\"", "timeout": 15}
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/pre_write.py\"", "timeout": 10}
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/post_write.py\"", "timeout": 20}
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/stop_checkpoint.py\"", "timeout": 15}
        ]
      }
    ]
  }
}
