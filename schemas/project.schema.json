{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/megafon/project.schema.json",
  "title": "Контур решения project state",
  "type": "object",
  "required": [
    "project_id",
    "title",
    "updated_at",
    "objective",
    "stage",
    "sources",
    "evidence",
    "options",
    "next_action"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "objective": {
      "type": "string"
    },
    "decision_owner": {
      "type": "string"
    },
    "stage": {
      "enum": [
        "intake",
        "research_plan",
        "research",
        "synthesis",
        "options",
        "strategy",
        "validation",
        "follow_up",
        "blocked",
        "complete"
      ]
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "research_questions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "options": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/option"
      }
    },
    "chosen_option_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "commitments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "owner",
          "metric",
          "due",
          "review_trigger"
        ],
        "properties": {
          "owner": {
            "type": "string"
          },
          "metric": {
            "type": "string"
          },
          "due": {
            "type": "string"
          },
          "review_trigger": {
            "type": "string"
          },
          "baseline": {
            "type": "string"
          },
          "stop_rule": {
            "type": "string"
          }
        }
      }
    },
    "unresolved_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_action": {
      "type": "string"
    },
    "path_base": {
      "enum": [
        "project",
        "repository"
      ]
    },
    "checkpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "at",
          "stage",
          "summary",
          "next_action",
          "sources"
        ]
      }
    },
    "product_strategy": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "communication_strategy": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "validation_plan": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "recommended_option_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "recommendation_rationale": {
      "type": "string"
    },
    "manual_baseline": {
      "type": "object",
      "properties": {
        "hours": {
          "type": [
            "number",
            "null"
          ]
        },
        "basis": {
          "type": "string"
        },
        "measured": {
          "type": "boolean"
        }
      }
    },
    "research_requirements": {
      "type": "object",
      "required": [
        "source_kinds",
        "rationale"
      ],
      "properties": {
        "source_kinds": {
          "type": "array",
          "items": {
            "enum": [
              "document",
              "table",
              "website",
              "interview",
              "synthetic",
              "tool_output",
              "model_respondent",
              "agent_note"
            ]
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "validation_design": {
      "type": "object",
      "required": [
        "status",
        "purpose",
        "data_origin",
        "sample",
        "thresholds"
      ],
      "properties": {
        "status": {
          "enum": [
            "planned",
            "running",
            "completed"
          ]
        },
        "purpose": {
          "enum": [
            "quality",
            "demand",
            "causal_effect",
            "exploratory"
          ]
        },
        "data_origin": {
          "enum": [
            "none",
            "synthetic",
            "real"
          ]
        },
        "sample": {
          "type": "object",
          "required": [
            "cases",
            "variants",
            "repeats",
            "planned_outputs"
          ],
          "properties": {
            "cases": {
              "type": "integer",
              "minimum": 1
            },
            "variants": {
              "type": "integer",
              "minimum": 1
            },
            "repeats": {
              "type": "integer",
              "minimum": 1
            },
            "planned_outputs": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "thresholds": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "metric",
              "value",
              "rationale",
              "basis"
            ],
            "properties": {
              "metric": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "string",
                "minLength": 1
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              },
              "agreement_reference": {
                "type": "string",
                "minLength": 1
              },
              "basis": {
                "enum": [
                  "proposed",
                  "owner_agreed",
                  "empirical"
                ]
              },
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "results": {
          "type": "object",
          "properties": {
            "artifact_path": {
              "type": "string",
              "minLength": 1
            },
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "source_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "unit_of_analysis": {
          "type": "string",
          "minLength": 1
        },
        "comparison": {
          "type": "string",
          "minLength": 1
        },
        "stop_rule": {
          "type": "string",
          "minLength": 1
        },
        "inference_limits": {
          "type": "string",
          "minLength": 1
        },
        "assignment": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "strategy_review": {
      "type": "object",
      "required": [
        "comparison",
        "strongest_objection",
        "reversal_condition",
        "evidence_limits",
        "state_hash",
        "reviewer"
      ],
      "properties": {
        "comparison": {
          "type": "string",
          "minLength": 1
        },
        "strongest_objection": {
          "type": "string",
          "minLength": 1
        },
        "reversal_condition": {
          "type": "string",
          "minLength": 1
        },
        "evidence_limits": {
          "type": "string",
          "minLength": 1
        },
        "state_hash": {
          "type": "string",
          "minLength": 1
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "decision_stress_tests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/decisionStressReview"
      },
      "description": "Append-only conditional review versions. Cross-reference and freshness checks run in scripts/stress_test.py."
    },
    "product_capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/productCapability"
      }
    },
    "marketing_claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/marketingClaim"
      }
    },
    "marketing_claims_audits": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/marketingClaimsAudit"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "source_id",
        "kind",
        "title",
        "url_or_path",
        "accessed_at",
        "scope",
        "limitations"
      ],
      "properties": {
        "source_id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "document",
            "table",
            "website",
            "interview",
            "synthetic",
            "tool_output",
            "model_respondent",
            "agent_note"
          ]
        },
        "title": {
          "type": "string"
        },
        "url_or_path": {
          "type": "string"
        },
        "published_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "accessed_at": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "limitations": {
          "type": "string"
        },
        "snapshot_path": {
          "type": "string",
          "minLength": 1
        },
        "synthetic": {
          "type": "boolean"
        },
        "verification": {
          "enum": [
            "http_snapshot",
            "agent_tool_snapshot",
            "search_snippet",
            "manual_file",
            "provided_by_user",
            "generated"
          ],
          "description": "How the content was obtained; search_snippet cannot corroborate evidence alone."
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "injection_flags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Instruction-like text found by scripts/snapshot.py; the source stays data."
        },
        "valid_until": {
          "type": [
            "string",
            "null"
          ],
          "description": "Date after which the source must be re-checked."
        },
        "publisher_or_owner": {
          "type": [
            "string",
            "null"
          ]
        },
        "content_kind": {
          "enum": [
            "page",
            "excerpt",
            "summary"
          ]
        },
        "evidence_scope": {
          "enum": [
            "general_guidance",
            "market_observation",
            "project_observation",
            "owner_input",
            "simulation",
            "description"
          ]
        },
        "quote_checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "excerpt",
              "found"
            ],
            "properties": {
              "excerpt": {
                "type": "string",
                "minLength": 1
              },
              "found": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "evidence_id",
        "claim",
        "claim_type",
        "source_ids",
        "method",
        "status",
        "limitations"
      ],
      "properties": {
        "evidence_id": {
          "type": "string"
        },
        "claim": {
          "type": "string"
        },
        "claim_type": {
          "enum": [
            "source_fact",
            "measured_fact",
            "association",
            "qualitative_signal",
            "hypothesis",
            "forecast",
            "decision"
          ]
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "method": {
          "type": "string"
        },
        "sample_n": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "effect": {
          "type": [
            "number",
            "null"
          ]
        },
        "interval": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "p_value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "q_value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "status": {
          "enum": [
            "provisional",
            "corroborated",
            "contradicted",
            "stale",
            "withdrawn"
          ]
        },
        "limitations": {
          "type": "string"
        },
        "related_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "locator": {
          "type": "string"
        },
        "claim_scope": {
          "enum": [
            "source_description",
            "owner_input",
            "project_observation",
            "market_demand",
            "causal_effect"
          ]
        },
        "support": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "source_id",
              "locator",
              "reason",
              "relation"
            ],
            "properties": {
              "source_id": {
                "type": "string",
                "minLength": 1
              },
              "locator": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "passage": {
                "type": "string",
                "minLength": 1
              },
              "relation": {
                "enum": [
                  "supports",
                  "context",
                  "contradicts"
                ]
              }
            }
          }
        }
      }
    },
    "option": {
      "type": "object",
      "required": [
        "option_id",
        "title",
        "benefits",
        "costs_and_risks",
        "objection",
        "evidence_ids"
      ],
      "properties": {
        "option_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "benefits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "costs_and_risks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "objection": {
          "type": "string"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "kind": {
          "enum": [
            "status_quo",
            "change",
            "pivot",
            "learn",
            "stop"
          ]
        }
      }
    },
    "decisionStressReview": {
      "title": "Conditional decision stress review, not an automatic decision",
      "type": "object",
      "required": [
        "schema_version",
        "review_id",
        "baseline",
        "reviewer",
        "strongest_objection",
        "reversal_condition",
        "limitations",
        "assumptions",
        "scenarios"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "review_id": {
          "type": "string",
          "minLength": 1
        },
        "baseline": {
          "type": "object",
          "required": [
            "project_id",
            "state_hash",
            "recommended_option_id",
            "option_ids",
            "evidence_ids",
            "source_ids",
            "source_content",
            "snapshot"
          ],
          "properties": {
            "project_id": {
              "type": "string",
              "minLength": 1
            },
            "state_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "recommended_option_id": {
              "type": "string",
              "minLength": 1
            },
            "option_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "evidence_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "source_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "source_content": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            },
            "snapshot": {
              "type": "object",
              "required": [
                "objective",
                "constraints"
              ],
              "properties": {
                "objective": {
                  "type": "string",
                  "minLength": 1
                },
                "constraints": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                }
              }
            }
          }
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "strongest_objection": {
          "type": "string",
          "minLength": 1
        },
        "reversal_condition": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "string",
          "minLength": 1
        },
        "assumptions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "assumption_id",
              "statement",
              "basis",
              "evidence_ids",
              "option_ids",
              "verification_needed"
            ],
            "properties": {
              "assumption_id": {
                "type": "string",
                "minLength": 1
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "basis": {
                "enum": [
                  "hypothesis",
                  "recorded_evidence",
                  "unknown"
                ]
              },
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "option_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "minItems": 1
              },
              "verification_needed": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "scenarios": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "scenario_id",
              "title",
              "premise",
              "premise_status",
              "assumption_ids",
              "evidence_ids",
              "changed_source_ids",
              "changed_evidence_ids",
              "constraint_changes",
              "option_impacts",
              "recommendation",
              "new_data_needed",
              "review_trigger"
            ],
            "properties": {
              "scenario_id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "premise": {
                "type": "string",
                "minLength": 1
              },
              "premise_status": {
                "enum": [
                  "hypothetical",
                  "observed"
                ]
              },
              "assumption_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "minItems": 1
              },
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "changed_source_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "changed_evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "constraint_changes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "before",
                    "after"
                  ],
                  "properties": {
                    "before": {
                      "type": "string",
                      "minLength": 1
                    },
                    "after": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "option_impacts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "option_id",
                    "feasibility",
                    "preference",
                    "reason",
                    "evidence_ids"
                  ],
                  "properties": {
                    "option_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "feasibility": {
                      "enum": [
                        "feasible",
                        "infeasible",
                        "uncertain"
                      ]
                    },
                    "preference": {
                      "enum": [
                        "preferred",
                        "not_preferred",
                        "undetermined"
                      ]
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1
                    },
                    "evidence_ids": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "uniqueItems": true
                    }
                  }
                }
              },
              "recommendation": {
                "type": "object",
                "required": [
                  "outcome",
                  "option_id",
                  "rationale",
                  "evidence_ids"
                ],
                "properties": {
                  "outcome": {
                    "enum": [
                      "keep",
                      "switch",
                      "insufficient_evidence"
                    ]
                  },
                  "option_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "rationale": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  }
                }
              },
              "new_data_needed": {
                "type": "string",
                "minLength": 1
              },
              "review_trigger": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "productCapability": {
      "type": "object",
      "required": [
        "capability_id",
        "description",
        "availability",
        "evidence_ids"
      ],
      "properties": {
        "capability_id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "availability": {
          "enum": [
            "implemented",
            "planned",
            "unknown"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "marketingClaim": {
      "type": "object",
      "required": [
        "claim_id",
        "text",
        "kind",
        "requires_causal_evidence",
        "capability_ids"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "quantitative",
            "qualitative"
          ]
        },
        "requires_causal_evidence": {
          "type": "boolean"
        },
        "capability_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        }
      }
    },
    "marketingClaimsAudit": {
      "type": "object",
      "required": [
        "schema_version",
        "review_id",
        "baseline",
        "reviewer",
        "limitations",
        "assessments"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "review_id": {
          "type": "string",
          "minLength": 1
        },
        "baseline": {
          "type": "object",
          "required": [
            "project_id",
            "state_hash",
            "evidence_ids",
            "claims",
            "capabilities",
            "evidence_catalog",
            "source_catalog"
          ],
          "properties": {
            "project_id": {
              "type": "string",
              "minLength": 1
            },
            "state_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "evidence_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "claims": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/marketingClaim"
              }
            },
            "capabilities": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/productCapability"
              }
            },
            "evidence_catalog": {
              "type": "object",
              "additionalProperties": {
                "type": "object"
              }
            },
            "source_catalog": {
              "type": "object",
              "additionalProperties": {
                "type": "object"
              }
            }
          }
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "string",
          "minLength": 1
        },
        "assessments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "claim_id",
              "original_claim",
              "capability_ids",
              "status",
              "evidence_links",
              "scope_match",
              "rationale",
              "accepted_wording",
              "validation_method"
            ],
            "properties": {
              "claim_id": {
                "type": "string",
                "minLength": 1
              },
              "original_claim": {
                "type": "string",
                "minLength": 1
              },
              "capability_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "minItems": 1
              },
              "status": {
                "enum": [
                  "supported",
                  "partially_supported",
                  "unsupported",
                  "contradicted"
                ]
              },
              "evidence_links": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "evidence_id",
                    "relation",
                    "coverage",
                    "reason"
                  ],
                  "properties": {
                    "evidence_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "relation": {
                      "enum": [
                        "supports",
                        "context",
                        "contradicts"
                      ]
                    },
                    "coverage": {
                      "enum": [
                        "full",
                        "partial"
                      ]
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "scope_match": {
                "type": "string",
                "minLength": 1
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              },
              "accepted_wording": {
                "type": "string",
                "minLength": 1
              },
              "validation_method": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
